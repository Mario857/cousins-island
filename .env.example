# Frontend (Vite) — all optional
# VITE_DEFAULT_NETWORK=pisco-1          # phoenix-1 (default) or pisco-1
# VITE_MARKETPLACE_ADDRESS=terra1...    # overrides src/config/deployments.json for phoenix-1
# VITE_PISCO_MARKETPLACE_ADDRESS=terra1...
# VITE_PHOENIX_RPC=https://...          # tried before the built-in public endpoints
# VITE_PHOENIX_REST=https://...
# VITE_PISCO_RPC=https://...
# VITE_PISCO_REST=https://...
# VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# Contract deploy script (npm run deploy:contracts) — never commit a real mnemonic
MNEMONIC=
NETWORK=pisco-1
# RPC=https://...
# FEE_BPS=250
# FEE_RECIPIENT=terra1...
# WASM_DIR=contracts/artifacts
