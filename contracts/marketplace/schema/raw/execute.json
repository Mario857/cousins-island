{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExecuteMsg",
  "oneOf": [
    {
      "description": "Called by a registered cw721 contract when an NFT is sent here with `send_nft`. The inner `msg` is a [`ReceiveNftMsg`].",
      "type": "object",
      "required": [
        "receive_nft"
      ],
      "properties": {
        "receive_nft": {
          "$ref": "#/definitions/Cw721ReceiveMsg"
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Change the price of your listing.",
      "type": "object",
      "required": [
        "update_price"
      ],
      "properties": {
        "update_price": {
          "type": "object",
          "required": [
            "collection",
            "price",
            "token_id"
          ],
          "properties": {
            "collection": {
              "type": "string"
            },
            "price": {
              "$ref": "#/definitions/Uint128"
            },
            "token_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Remove your listing; the NFT is sent back to you.",
      "type": "object",
      "required": [
        "cancel_listing"
      ],
      "properties": {
        "cancel_listing": {
          "type": "object",
          "required": [
            "collection",
            "token_id"
          ],
          "properties": {
            "collection": {
              "type": "string"
            },
            "token_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Buy a listed NFT. Send exactly the listing price in the marketplace denom.",
      "type": "object",
      "required": [
        "buy"
      ],
      "properties": {
        "buy": {
          "type": "object",
          "required": [
            "collection",
            "token_id"
          ],
          "properties": {
            "collection": {
              "type": "string"
            },
            "token_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Offer to buy an NFT (listed or not). The attached funds are held by the contract until the bid is accepted or cancelled.",
      "type": "object",
      "required": [
        "place_bid"
      ],
      "properties": {
        "place_bid": {
          "type": "object",
          "required": [
            "collection",
            "token_id"
          ],
          "properties": {
            "collection": {
              "type": "string"
            },
            "token_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Cancel your bid and get the funds back.",
      "type": "object",
      "required": [
        "cancel_bid"
      ],
      "properties": {
        "cancel_bid": {
          "type": "object",
          "required": [
            "bid_id"
          ],
          "properties": {
            "bid_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Accept a bid on an NFT you have listed here. (To accept a bid on an NFT that isn't listed, `send_nft` it with `ReceiveNftMsg::AcceptBid`.)",
      "type": "object",
      "required": [
        "accept_bid"
      ],
      "properties": {
        "accept_bid": {
          "type": "object",
          "required": [
            "bid_id"
          ],
          "properties": {
            "bid_id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin: register or update a collection.",
      "type": "object",
      "required": [
        "set_collection"
      ],
      "properties": {
        "set_collection": {
          "type": "object",
          "required": [
            "address",
            "collection"
          ],
          "properties": {
            "address": {
              "type": "string"
            },
            "collection": {
              "$ref": "#/definitions/CollectionInput"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Admin: change settings.",
      "type": "object",
      "required": [
        "update_config"
      ],
      "properties": {
        "update_config": {
          "type": "object",
          "properties": {
            "admin": {
              "type": [
                "string",
                "null"
              ]
            },
            "fee_bps": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "minimum": 0.0
            },
            "fee_recipient": {
              "type": [
                "string",
                "null"
              ]
            },
            "paused": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "Binary": {
      "description": "Binary is a wrapper around Vec<u8> to add base64 de/serialization with serde. It also adds some helper methods to help encode inline.\n\nThis is only needed as serde-json-{core,wasm} has a horrible encoding for Vec<u8>. See also <https://github.com/CosmWasm/cosmwasm/blob/main/docs/MESSAGE_TYPES.md>.",
      "type": "string"
    },
    "CollectionInput": {
      "description": "Collection details set by the admin. Shown on the collection page.",
      "type": "object",
      "required": [
        "enabled",
        "name",
        "royalty_bps"
      ],
      "properties": {
        "banner": {
          "description": "Banner image URL (https:// or ipfs://).",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "discord": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "description": "Disabled collections can't be listed, bought or bid on; existing listings and bids can still be cancelled.",
          "type": "boolean"
        },
        "image": {
          "description": "Logo image URL (https:// or ipfs://).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "royalty_bps": {
          "description": "Creator royalty in basis points (450 = 4.5%). At most 1500 (15%).",
          "type": "integer",
          "format": "uint16",
          "minimum": 0.0
        },
        "royalty_recipient": {
          "description": "Required when royalty_bps > 0.",
          "type": [
            "string",
            "null"
          ]
        },
        "twitter": {
          "type": [
            "string",
            "null"
          ]
        },
        "website": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Cw721ReceiveMsg": {
      "description": "Cw721ReceiveMsg should be de/serialized under `Receive()` variant in a ExecuteMsg",
      "type": "object",
      "required": [
        "msg",
        "sender",
        "token_id"
      ],
      "properties": {
        "msg": {
          "$ref": "#/definitions/Binary"
        },
        "sender": {
          "type": "string"
        },
        "token_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Uint128": {
      "description": "A thin wrapper around u128 that is using strings for JSON encoding/decoding, such that the full u128 range can be used for clients that convert JSON numbers to floats, like JavaScript and jq.\n\n# Examples\n\nUse `from` to create instances of this and `u128` to get the value out:\n\n``` # use cosmwasm_std::Uint128; let a = Uint128::from(123u128); assert_eq!(a.u128(), 123);\n\nlet b = Uint128::from(42u64); assert_eq!(b.u128(), 42);\n\nlet c = Uint128::from(70u32); assert_eq!(c.u128(), 70); ```",
      "type": "string"
    }
  }
}
