{
  "name": "cousins-island",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Cousins Island NFT marketplace on Terra (phoenix-1)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:contracts": "tsx --env-file-if-exists=.env scripts/deploy.ts",
    "format": "prettier --write src scripts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@cosmjs/amino": "~0.38.1",
    "@cosmjs/cosmwasm-stargate": "~0.38.1",
    "@cosmjs/encoding": "~0.38.1",
    "@cosmjs/proto-signing": "~0.38.1",
    "@cosmjs/stargate": "~0.38.1",
    "@emotion/is-prop-valid": "^1.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "axios": "^1.20.0",
    "big.js": "^7.0.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "js-cookie": "^3.0.8",
    "lodash": "^4.18.1",
    "lscache": "^1.3.2",
    "numeral": "^2.0.6",
